{
  "name": "zhangwei-prompts-data",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "test": "node --test",
    "migrate": "node scripts/migrate-from-gallery.mjs",
    "migrate:v2": "node scripts/migrate-schema-v2.mjs --checked-at=2026-07-12",
    "migrate:report": "node scripts/rebuild-exclusion-report.mjs",
    "proofs:plan": "node scripts/build-proof-stage-plan.mjs",
    "proofs:audit-legacy": "node scripts/audit-legacy-proof-assets.mjs",
