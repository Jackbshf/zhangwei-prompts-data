    "proofs:cost-plan": "node scripts/build-proof-cost-plan.mjs",
    "proofs:preflight": "node scripts/proof-execution-preflight.mjs",
    "proofs:input-review": "node scripts/build-proof-input-review-pack.mjs",
    "proofs:execution-manifest": "node scripts/create-proof-execution-manifest.mjs",
    "proofs:openai": "node scripts/execute-openai-proof-batch.mjs",
    "proofs:publication-manifest": "node scripts/build-repository-publication-manifest.mjs",
    "proofs:dreamina-review": "node scripts/build-dreamina-review-pack.mjs",
    "validate": "node scripts/validate.mjs",
    "verify": "npm run test && npm run validate"
